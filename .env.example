# DealFlow360 Environment Configuration Template
# Copy this file to .env for local development

# Database Configuration (PostgreSQL in production, SQLite fallback supported for quick local development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dealflow360
# For local SQLite fallback: sqlite:///./dealflow360.db

# Authentication / Security
JWT_SECRET=change-this-to-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
ENVIRONMENT=development
API_V1_PREFIX=/api
